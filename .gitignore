# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/

# Virtual environments
.venv/

# Caches
.ruff_cache/
.ty_cache/
.pytest_cache/

# Data and models at the repository root only (a bare `data/` would also hide the
# Python package src/granita/data)
/data/
/checkpoints/
/runs/
*.onnx
*.safetensors
*.pt


# Released models, tracked on purpose (see models/README.md); weights elsewhere stay ignored
!models/**

# Mobile test shells (apps/): generated projects and build output
apps/ios/GranitaShell.xcodeproj/
apps/ios/Info.plist
apps/ios/build/
apps/android/.gradle/
apps/android/.kotlin/
apps/android/build/
apps/android/app/build/
apps/android/local.properties
